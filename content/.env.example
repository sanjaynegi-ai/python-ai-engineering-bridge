# Copy this file to .env (git ignores .env) and fill in the provider you use.
# Never commit .env, and never paste a key into a notebook or source file.

# --- Chat models (Session 01, Part 8) -------------------------------------
# Which provider the course code uses: openai | anthropic | openrouter | ollama
LLM_PROVIDER=openai

# Model ID for that provider. IDs differ between providers:
#   openai      gpt-5.6-terra
#   anthropic   claude-haiku-5-5   (claude-opus-5-5 is more capable, about 40x the price)
#   openrouter  openai/gpt-5.6-terra   or   anthropic/claude-haiku-5.5
#   ollama      llama3.2
LLM_MODEL=gpt-5.6-terra

# Only the key for your chosen provider is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama needs no key. Change this only if Ollama runs on another host or port.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Embedding models (Session 01, Part 9) --------------------------------
# Which embedding provider to use: openai | fastembed
#   openai      text-embedding-3-small     (needs OPENAI_API_KEY)
#   fastembed   BAAI/bge-small-en-v1.5     (local and free; no key)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Where fastembed keeps downloaded models. The course code uses ~/.cache/fastembed
# unless you uncomment this. Don't leave it set but empty: an empty value makes
# fastembed download into whatever folder you happen to run from.
# FASTEMBED_CACHE_PATH=/path/to/model-cache
