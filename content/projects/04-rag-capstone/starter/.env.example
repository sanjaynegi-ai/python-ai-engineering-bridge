# Copy this file to .env to change the settings. Never commit .env.
# Every setting has a default; these lines show the defaults.

# Where the documents are, and where the index is kept.
ASSISTANT_DOCUMENTS=data/docs
ASSISTANT_INDEX=index

# fastembed runs a real embedding model locally (a 67 MB download on first use,
# shared with Session 11). hashing matches words, not meaning: instant and free.
ASSISTANT_EMBEDDER=fastembed
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Changing these needs a rebuild: knowledge-assistant ingest --rebuild
ASSISTANT_CHUNK_SIZE=800
ASSISTANT_CHUNK_OVERLAP=100
