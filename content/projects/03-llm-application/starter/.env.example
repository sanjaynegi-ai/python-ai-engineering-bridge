# Copy this file to .env to configure the LLM. Never commit .env.
# The variable names match the course repository's .env (Session 01, Part 8).

LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
# Leave unset for api.openai.com. Set it for an OpenAI-compatible gateway.
# OPENAI_BASE_URL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000

# USD per million tokens, from your provider's pricing page. Leave unset if you
# don't know them: the cost is then reported as unknown, rather than guessed.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=
