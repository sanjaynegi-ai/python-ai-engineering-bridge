# Copy this file to .env to change the defaults. Never commit .env.
# Every setting is optional; the values below are the defaults.
INCIDENT_INPUT_DIR=data/exports
INCIDENT_OUTPUT_FILE=out/report.json
# JSON: hours allowed per priority. Must cover P1-P4 and increase from P1 to P4.
INCIDENT_SLA_HOURS={"P1": 4, "P2": 24, "P3": 72, "P4": 168}

# The Asset Inventory API (Session 08). Leave the token unset to run without it.
INCIDENT_INVENTORY_BASE_URL=http://127.0.0.1:8765
# INCIDENT_INVENTORY_TOKEN=local-dev-token
INCIDENT_INVENTORY_TIMEOUT_SECONDS=5
INCIDENT_INVENTORY_DEADLINE_SECONDS=10
